+               -o /tmp/varve-install.sh \
+               https://raw.githubusercontent.com/pulseengine/varve/main/install.sh
+          sh /tmp/varve-install.sh
+          echo "$HOME/.varve/bin" >> "$GITHUB_PATH"
+      - name: Lay down the pinned layer and expose spar by path
+        run: |
+          set -euo pipefail
+          varve install
+          # The TOOL shims live in $VARVE_ROOT/shims and exist only after
