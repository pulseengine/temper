+          # The gate refuses any binary that does not answer `--version` as a
+          # spar should, and a stale `spar` earlier on PATH is precisely what it
+          # refuses — so naming the path is both safer and the thing the failure
+          # message tells a reader to do.
+          SPAR="$HOME/.varve/shims/spar"
+          test -x "$SPAR" || {
+            echo "::error::no executable spar shim at $SPAR after varve shim install"
