{
  "env": {
    "node": true,
    "jest": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "ignorePatterns": [
    "src/htmx.min.js",
    "src/idiomorph-ext.min.js",
    "src/dashboard-client.js"
  ],
  "rules": {
    "no-console": "off",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"]
  }
}
