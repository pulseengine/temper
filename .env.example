# Required: GitHub App credentials
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# Optional: Target organization (also configurable in config.yml)
ORGANIZATION=pulseengine

# Optional: Server settings
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Optional: Webhook path (default: /api/github/webhooks)
WEBHOOK_PATH=/api/github/webhooks

# Legacy env var names (also accepted)
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
